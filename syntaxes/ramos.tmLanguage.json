{
  "name": "Ramos",
  "scopeName": "source.ramos",
  "fileTypes": [
    "ramos"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ramos",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.ramos",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ramos",
      "begin": "s?\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.ramos"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ramos"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.ramos",
          "match": "\\\\[ntr0\"\\\\]"
        },
        {
          "name": "invalid.illegal.escape.ramos",
          "match": "\\\\."
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.ramos"
        },
        "2": {
          "name": "entity.name.function.ramos"
        }
      }
    },
    "function-call": {
      "name": "entity.name.function.call.ramos",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "types": {
      "name": "storage.type.ramos",
      "match": "\\b(int64|bool|bytes|string|void)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.ramos",
      "match": "\\b(true|false)\\b"
    },
    "keywords": {
      "name": "keyword.control.ramos",
      "match": "\\b(let|var|if|else|while|for|in|break|continue|return|struct|weave)\\b"
    },
    "intrinsics": {
      "name": "support.function.builtin.ramos",
      "match": "\\b(print|buffer|buffer_len|buffer_get|buffer_set|arg_count|arg|read_file|write_file|io_error|stderr|exit|platform|read_line|stdin_eof|int_to_text|text_to_int|parse_error|collect|memory_used|string|to_bytes|len|slice|array|array_len|array_get|array_set|array_resize|array_empty|_protect_input|stdout|file_open|file_read|file_write|file_eof|file_close|terminal_start|terminal_stop|terminal_width|terminal_height|terminal_key|file_seek|_gui_open|_gui_control|_gui_text|_gui_poll|_gui_close|cwd|env_get|dir_open|dir_next|dir_kind|dir_close|dir_create|_process_run)\\b(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.ramos",
      "match": "\\+=|-=|\\.\\.|&&|\\|\\||==|!=|<=|>=|->|[+*/%!=<>-]"
    },
    "numbers": {
      "name": "constant.numeric.integer.decimal.ramos",
      "match": "\\b[0-9]+\\b"
    },
    "punctuation": {
      "name": "punctuation.separator.ramos",
      "match": "[(){}\\[\\]:,.]"
    }
  }
}
