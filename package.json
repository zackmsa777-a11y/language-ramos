{
  "name": "language-ramos",
  "displayName": "Ramos",
  "description": "Ramos language highlighting and editor configuration",
  "version": "0.9.0",
  "publisher": "zackmsa777-a11y",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zackmsa777-a11y/language-ramos.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "ramos",
        "aliases": [
          "Ramos",
          "ramos"
        ],
        "extensions": [
          ".ramos"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ramos",
        "scopeName": "source.ramos",
        "path": "./syntaxes/ramos.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node tests/highlighting.cjs",
    "package": "vsce package --out language-ramos.vsix"
  },
  "devDependencies": {
    "vscode-textmate": "^9.0.0",
    "vscode-oniguruma": "^2.0.1",
    "@vscode/vsce": "^3.0.0"
  }
}
